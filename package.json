{
  "name": "tbrn-games",
  "version": "0.0.1",
  "private": true,
  "description": "Free, open-source local party games. Laptop host + phone controllers via QR.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --watch --test \"tests/**/*.test.ts\"",
    "probe": "node scripts/deep-probe.ts",
    "assets:build": "node scripts/generate-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "fonts": "node scripts/install-fonts.mjs",
    "shots": "node scripts/shots.ts",
    "check:design": "node scripts/check-design.ts"
  },
  "dependencies": {
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/modak": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "pixi.js": "^8.22.0",
    "qrcode": "^1.5.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.10",
    "eslint": "^9.0.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}
