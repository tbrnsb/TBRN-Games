{
  "name": "tbrn-games",
  "version": "0.0.1",
  "private": true,
  "description": "Free, open-source local party games. Laptop host + phone controllers via QR.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --watch --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}
